<?xml version="1.0"?>
<package format="3">
  <name>motkin_gz_ros2_control</name>
  <version>1.0.0</version>
  <description>Gazebo ros2_control package allows to control simulated robots using ros2_control framework.</description>
  <maintainer email="guilhem.saurel@laas.fr">Guilhem Saurel</maintainer>
  <author>Olivier Stasse</author>
  <license>Apache-2.0</license>

  <author email="olivier.stasse@laas.fr">Olivier Stasse</author>
  <url type="repository">https://github.com/Gepetto/motkin-gz-ros2-control</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- keep-sorted start -->
  <depend>controller_manager</depend>
  <depend>gz_plugin_vendor</depend>
  <depend>gz_sim_vendor</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>ros2_control_cmake</depend>
  <depend>yaml_cpp_vendor</depend>
  <!-- keep-sorted end -->

  <!-- keep-sorted start -->
  <test_depend>ament_cmake_copyright</test_depend>
  <test_depend>ament_cmake_cppcheck</test_depend>
  <test_depend>ament_cmake_cpplint</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <!-- keep-sorted end -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
